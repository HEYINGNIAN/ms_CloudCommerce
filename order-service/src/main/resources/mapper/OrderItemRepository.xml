<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.orderservice.repository.OrderItemRepository">
    
    <!-- 根据订单ID查询订单项 -->
    <select id="selectByOrderId" resultType="com.example.orderservice.entity.OrderItem">
        SELECT * FROM t_order_item WHERE order_id = #{orderId}
    </select>
    
</mapper>